{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "instructions": ["AGENTS.md"],
  "plugin": [],
  "agent": {
    "orchestrator": {
      "description": "Planeja e delega tarefas de engenharia do bot Teams; não implementa diretamente.",
      "mode": "primary",
      "prompt": "{file:./.opencode/agents/orchestrator.md}",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "task": {"*": "allow"}
      },
      "tools": {"task": true, "read": true, "edit": false, "bash": false}
    },
    "teams-implementer": {
      "description": "Implementa handlers, estado e integrações do bot Teams.",
      "mode": "subagent",
      "prompt": "{file:./.opencode/agents/teams-implementer.md}\n{file:./.opencode/skills/teams-bot-skill/SKILL.md}",
      "permission": {"edit": "allow", "bash": "allow", "task": {"*": "deny"}},
      "tools": {"read": true, "edit": true, "bash": true}
    },
    "teams-frontend-engineer": {
      "description": "Implementa Adaptive Cards e UI declarada para Teams.",
      "mode": "subagent",
      "prompt": "{file:./.opencode/agents/teams-frontend-engineer.md}\n{file:./.opencode/skills/teams-bot-skill/SKILL.md}",
      "permission": {"edit": "allow", "bash": "allow", "task": {"*": "deny"}},
      "tools": {"read": true, "edit": true, "bash": true}
    },
    "code-reviewer": {
      "description": "Revisa código e configurações com foco em corretude, segurança e permissões; não edita.",
      "mode": "subagent",
      "prompt": "{file:./.opencode/agents/code-reviewer.md}\n{file:./.opencode/skills/teams-bot-skill/SKILL.md}",
      "permission": {"edit": "deny", "bash": "deny", "task": {"*": "deny"}},
      "tools": {"read": true, "edit": false, "bash": false}
    },
    "test-engineer": {
      "description": "Valida build e cenários do bot no Playground; não altera código de produção.",
      "mode": "subagent",
      "prompt": "{file:./.opencode/agents/test-engineer.md}\n{file:./.opencode/skills/teams-bot-skill/SKILL.md}",
      "permission": {"edit": "deny", "bash": "allow", "task": {"*": "deny"}},
      "tools": {"read": true, "edit": false, "bash": true}
    }
  },
  "mcp": {
    "servers": {
      "notion": {
        "type": "remote",
        "url": "https://mcp.notion.com/mcp"
      },
      "trello": {
        "type": "remote",
        "url": "https://mcp.trello.com/v1"
      }
    }
  }
}